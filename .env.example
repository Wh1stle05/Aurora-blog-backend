ENV=prod
# serverless（Vercel）下建议使用 Neon 的 pooled 连接串（主机名带 -pooler）：
# POSTGRES_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/blogdb?sslmode=require
DATABASE_URL=postgresql+psycopg://blog:blogpass@db:5432/blogdb
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=15
ADMIN_EMAILS=you@example.com
CORS_ORIGINS=https://aurorablog.me,https://www.aurorablog.me,https://admin.aurorablog.me
RESEND_API_KEY=
RESEND_FROM=Aurora Blog <no-reply@aurorablog.me>
TURNSTILE_SECRET_KEY=
FRONTEND_REVALIDATE_URL=https://aurorablog.me/api/revalidate
FRONTEND_REVALIDATE_SECRET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://cdn.aurorablog.me
REFRESH_TOKEN_EXPIRES_DAYS=30
REFRESH_TOKEN_PEPPER=change-me

# --- serverless / Vercel ---
# Vercel 会自动注入 VERCEL=1；其他 serverless 平台可显式设 SERVERLESS=1。
# SERVERLESS=1
#
# 连接池：serverless 环境下默认 NullPool（不池化），需要上游池化（Neon -pooler）。
# 想强制恢复连接池：DB_POOL=default
# DB_POOL=default
#
# 常驻系统监控循环在 serverless 下默认关闭，改用定时任务调用
# GET /api/system/cron/monitor（需带 Authorization: Bearer $CRON_SECRET）。
# 自托管想强制开启：ENABLE_SYSTEM_MONITOR=1
ENABLE_SYSTEM_MONITOR=
CRON_SECRET=change-me-cron-secret
